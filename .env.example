# Copiar como .env y completar. Ninguna variable tiene valor por defecto:
# si falta alguna, la app no arranca.

# Base de datos (Railway → servicio MySQL → Variables)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=aimaaromas

# Sesiones: un texto aleatorio de 32 caracteres o más
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=img_productos

NEXT_PUBLIC_SITE_URL=http://localhost:3000
