# Copiar como .env y completar. Las variables de base de datos y JWT_SECRET
# no tienen valor por defecto: si falta alguna, la app no arranca.

# Base de datos (TiDB Cloud → Connect)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
# TiDB Cloud exige TLS
DB_SSL=true

# Sesiones: un texto aleatorio de 32 caracteres o más
JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=img_productos

# URL pública del sitio (sitemap, vistas previas al compartir, SEO)
NEXT_PUBLIC_SITE_URL=https://aimaaromas.com.ar

# Aviso por mail de cada pedido nuevo (Resend, plan gratuito).
# Sin RESEND_API_KEY el pedido se guarda igual, pero no se envía el mail.
# El destinatario se cambia desde Admin → Configuración.
RESEND_API_KEY=
EMAIL_FROM="AIMA Aromas <onboarding@resend.dev>"

# Anti-spam opcional (Cloudflare Turnstile, gratis). Sin estas claves
# quedan activos igualmente el límite por IP y el campo trampa (honeypot).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
