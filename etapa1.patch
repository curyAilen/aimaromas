+// Límites para evitar pedidos absurdos desde la tienda
+const MAX_ITEMS = 50;
+const MAX_QTY_PER_ITEM = 100;
+
+interface IncomingItem {
+    id_product: number;
+    id_variant: number | null;
+    quantity: number;
+}
+
+interface PricedItem {
+    id_product: number;
+    id_variant: number | null;
+    product_name: string;
+    variant_scent: string | null;
+    quantity: number;
+    unit_price: number;
+    subtotal: number;
+    tag: string;
+}
